// wasi:video-encoder — DRAFT (wandr). NOT WIRED.
//
// The video CODEC — pure WebCodecs `VideoEncoder`: raw frames in, compressed frames
// out. SOURCE-AGNOSTIC. The camera is factored out to wasi:camera (W3C precedent: the
// web platform splits Media Capture and Streams from WebCodecs), so this package owns
// neither a camera nor a surface: a guest wires a `wasi:video-frame` `frame` — from
// wasi:camera today, wasi:canvas / screen-share later — into `encode`, and pulls the
// compressed output with `next-frame` to RTP-packetize + SRTP-seal + send. Raw pixels
// never cross the boundary: a `frame` handle is opaque + host-held, so a wasi:camera
// frame encodes zero-copy. The viewfinder is the CAMERA's concern (wasi:camera
// connect-preview); placement is the SURFACE's; content orientation travels ON the
// frame (`frame.rotation`), so the codec is orientation-agnostic.
//
// v0.0.2 (2026-08-05): factored the camera OUT (the "second consumer arrives" trigger
//   for the shared VideoFrame). Removed `camera-facing`, `encoder-config.facing`,
//   `connect-preview` (viewfinder → wasi:camera), and `display-rotation` (→
//   wasi:video-frame `frame.rotation`); added `encode(frame)`. v0.0.1 was the
//   camera-owning encoder. The fused wandr:video encoder keeps shipping the call path
//   until wiring (R3 coexistence).
package wasi:video-encoder@0.0.2;

interface types {
    enum codec { vp8, vp9, h264, h265 }

    enum video-error {
        unsupported-codec,
        no-hw-codec,
        codec-init-failed,
        /// The submitted frame could not be encoded (bad dimensions / unsupported
        /// pixel layout for this codec).
        bad-frame,
    }

    /// One compressed frame (ready for RTP packetization).
    record encoded-frame {
        data: list<u8>,
        /// 90 kHz media timestamp (the RTP transport clock).
        timestamp: u32,
        keyframe: bool,
    }

    /// The OUTPUT codec configuration (= WebCodecs `VideoEncoderConfig`): the target
    /// coded size + rate. Input frames are scaled to it as needed. No `facing` — the
    /// source is wasi:camera's concern, not the codec's.
    record encoder-config {
        codec: codec,
        width: u32,
        height: u32,
        bitrate-bps: u32,
        framerate: u32,
    }
}

interface encoder {
    use types.{codec, encoder-config, encoded-frame, video-error};
    use wasi:video-frame/types@0.0.1.{frame};

    resource video-encoder {
        /// Open a hardware encoder for `config`. No camera, no surface — pure codec.
        open: static func(config: encoder-config)
              -> result<video-encoder, video-error>;

        /// Submit one raw frame to encode (= WebCodecs `VideoEncoder.encode(VideoFrame)`).
        /// The frame is BORROWED — the source (wasi:camera / canvas) keeps ownership;
        /// pixels stay host-side, so a camera frame encodes zero-copy. `frame.rotation`
        /// travels with the frame; the encoder does not interpret it (a receiver
        /// applies the CVO on the sending side's behalf).
        encode: func(frame: borrow<frame>) -> result<_, video-error>;

        /// Pull the next compressed frame; none = not ready yet (poll on the embedder's
        /// frame cadence — the shipped consumer's model). The guest RTP-packetizes +
        /// SRTP-seals + sends.
        next-frame: func() -> option<encoded-frame>;

        /// Force a keyframe (on the receiver's RTCP PLI/FIR).
        request-keyframe: func();
        /// Adapt to congestion (the guest drives this from REMB/TWCC).
        set-bitrate: func(bitrate-bps: u32);
    }
}

world video-encoder-guest {
    import types;
    import encoder;
}
