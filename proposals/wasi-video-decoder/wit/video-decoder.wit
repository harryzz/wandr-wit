// wasi:video-decoder — DRAFT (wandr). NOT WIRED.
//
// The FACTORED form of wandr:video's decoder half — a hardware video decoder as a
// graphics-context consumer (the "media element" of the surface socket, beside
// webgpu / frame-buffer / wasi:canvas; the ownership-axes model,
// proposals/wasi-surface/DESIGN.md). The decoder fills the connected surface's
// buffers host-side; decoded frames never cross the boundary.
//
// TWO LANES, one decoder (a guest uses one, never both on the same instance):
//   * RTP / call lane   — `submit(encoded-frame)` with a 90 kHz transport timestamp;
//     `queue-full` == LOSS (resend after a keyframe). Live-call-verified (Signal).
//   * PLAYBACK lane      — `submit-timed(timed-frame)` with a real µs presentation PTS;
//     the host emits opaque `decoded-frame`s the guest schedules via `present(at-ns)`
//     on the wasi:clocks monotonic timeline, slaving video to the wasi:audio master
//     clock for A/V sync. `queue-full` == BACK-PRESSURE (retry the SAME frame).
//     Production-verified: wandr.jellyfin + wandr.dash (mp4/mkv/webm, DASH/HLS, seek).
//
// What is factored OUT vs the shipped fused contract (wit/video.wit): surface
// PLACEMENT — `set-rect`, `set-visible`, z-layer — is the SURFACE's vocabulary
// (wasi:surface, request/configure). What STAYS here: content-orientation correction
// (`set-rotation` — a property of the FRAMES, the peer's CVO, not of placement); the
// whole decode/composite pipeline; and `presented-rect` (see below).
//
// `presented-rect` STAYS ON THE DECODER, not wasi:surface: it reports where the
// aspect-preserving letterbox landed the picture inside the connected surface, and
// that is the PRODUCER's decision — only the decoder knows the coded aspect. A
// content-agnostic compositor surface (upstream wasi-gfx) cannot compute it and must
// not carry media-fit semantics; a fill producer (webgpu/canvas) has no such rect.
// So it is a decode-fill RESULT, and belongs with the producer that letterboxes.
//
// ‼️ OPEN — z-order changes OWNER in this factoring (flagged in NOTES.md): shipped
// wandr:video says "the guest owns z policy"; moving z to wasi:surface makes it
// embedder-governed (guest may only REQUEST). Resolve before wiring — keep a guest
// z-intent request verb on wasi:surface, or restate wandr:video's wording. Tracked
// separately from this decoder contract.
//
// v0.0.2 (2026-08-05): carried the task-117 PLAYBACK lane (`timed-frame`,
//   `submit-timed`, `next-decoded`, the `decoded-frame` resource, `flush`, `reset`),
//   the capability-probe / hardware-preference cluster (`acceleration`, `decoder-info`,
//   `list-decoders`, `open-accelerated`, `implementation`), and `av1` up from the
//   now-production-proven `wandr:video@0.1.0`. v0.0.1 was the RTP/call-lane-only slice
//   and predated all of it. The RTP lane is unchanged; everything added is additive.
package wasi:video-decoder@0.0.2;

interface types {
    /// `av1` is PLAYBACK-only (task 117): the host decodes it in software (dav1d,
    /// BSD-2) or via a platform HW block, and never encodes it. APPENDED last on
    /// purpose — existing discriminants (vp8=0…h265=3) are unchanged, so shipped
    /// call guests keep working.
    enum codec { vp8, vp9, h264, h265, av1 }

    enum video-error {
        unsupported-codec,
        no-hw-codec,
        codec-init-failed,
        bad-frame,
        /// RTP lane: input queue full — frame dropped; resend after a keyframe.
        /// PLAYBACK lane (`submit-timed`): BACK-PRESSURE — retry the SAME frame once
        /// `next-decoded` has drained one. A file cannot resync on the next keyframe
        /// without visibly skipping, so this inverts the RTP "drop it" semantics.
        queue-full,
        /// No connected surface can accept output.
        surface-unavailable,
    }

    /// One compressed frame for the RTP / call lane (e.g. reassembled from RTP after
    /// SRTP-open).
    ///
    /// ENCRYPTED MEDIA (task 108): `decrypt` carries per-frame Common-Encryption
    /// params (= WebCodecs `decryptConfig`, owned by wasi:eme); the key comes from a
    /// wasi:eme `key-session` bound at decoder open. For a robust CDM the decoder is
    /// secure-surface-only (decode-to-surface already keeps frames host-side — the
    /// natural fit). Additive; cleartext when `decrypt` = none.
    use wasi:eme/eme@0.0.1.{decrypt-config};
    record encoded-frame {
        data: list<u8>,
        /// 90 kHz media timestamp (the RTP transport clock).
        timestamp: u32,
        /// true = IDR / keyframe; decoders need one to start.
        keyframe: bool,
        /// none = cleartext; some = encrypted — decrypt host-side via the
        /// key-session bound at `open`.
        decrypt: option<decrypt-config>,
    }

    /// One compressed frame for the PLAYBACK lane (task 117) — the sibling of
    /// `encoded-frame`. The difference that matters: `timestamp-us` is a real
    /// PRESENTATION timestamp in microseconds (the WebCodecs unit, matching
    /// `wasi:audio-codec`'s `timestamp-us: s64`), not a 90 kHz transport clock that
    /// wraps every ~13.25 h. Signed, because containers legitimately carry negative
    /// PTS (encoder delay / edit lists).
    ///
    /// Decode order, not display order: a stream with B-frames is submitted in
    /// storage order and the host emits `decoded-frame`s in DISPLAY order. A submit
    /// may yield zero, one, or several decoded frames.
    record timed-frame {
        data: list<u8>,
        timestamp-us: s64,
        keyframe: bool,
    }

    record decoder-config {
        codec: codec,
        /// Coded-size hint for codec init (from signaling / the container); the
        /// stream's actual size wins where the codec carries dimensions.
        width: u32,
        height: u32,
    }

    /// Whether a decoder should run on a hardware block or in software. Mirrors
    /// WebCodecs' `hardwareAcceleration` rather than inventing a third spelling.
    /// `prefer-*` are hints — the host falls back if the preference cannot be met,
    /// because a player that refuses to play is worse than one that plays in
    /// software. `require-hardware` is the honest opt-out for a caller that would
    /// rather fail than silently pay CPU it cannot afford, and it is the ONLY value
    /// that can turn a working decode into an error.
    ///
    /// SHARED VOCABULARY with wasi:audio-codec (kept identical so a guest's HW/SW
    /// fallback logic is uniform across the A/V pair; candidate to hoist into a common
    /// wasi:media-types package). `require-hardware` matters more here than for audio
    /// — software VIDEO decode costs real CPU at frame rate, where software audio
    /// decode is cheap — but the vocabulary stays the same on both.
    enum acceleration {
        no-preference,
        prefer-hardware,
        prefer-software,
        require-hardware,
    }

    /// `probe` result (= WebCodecs `isConfigSupported`, but explicit about the LANE
    /// so the guest can choose rather than have the host hide it). Shared vocabulary
    /// with wasi:audio-codec's `support`.
    enum support { hardware, software, unsupported }

    /// A sub-rectangle of the connected surface, in SURFACE pixels (the same
    /// coordinate space the guest draws its UI in). Used only as the RESULT of
    /// `presented-rect` — where the aspect-corrected picture landed after
    /// letterbox/pillarbox. Distinct from surface PLACEMENT geometry (that is
    /// wasi:surface's request/configure), because this is a decode-fill result the
    /// producer computes, not a position the guest requests.
    record content-rect {
        x: u32,
        y: u32,
        width: u32,
        height: u32,
    }

    /// One decoder implementation the host can offer for a codec.
    record decoder-info {
        codec: codec,
        /// Implementation name — `vaapi`, `openh264`, `mediacodec`… Diagnostic only:
        /// a guest should choose on `hardware`, not on this per-platform string,
        /// which is not part of any compatibility promise.
        name: string,
        hardware: bool,
    }
}

interface decoder {
    use types.{codec, decoder-config, encoded-frame, timed-frame, acceleration,
               support, decoder-info, content-rect, video-error};
    use wasi:graphics-context/graphics-context@0.0.2.{context};
    use wasi:eme/eme@0.0.1.{key-session};  // ENCRYPTED MEDIA: the bound keys

    /// What this host can ACTUALLY decode, on THIS machine, right now.
    ///
    /// ‼️ PROBED, NOT DECLARED. A hardware backend asks its driver; a build with a
    /// VA-API backend on a machine with no VA driver reports nothing for it. So an
    /// empty result for a codec means "not decodable here" — the only form of the
    /// answer a guest can act on. WHY A GUEST NEEDS THIS: to choose a stream it can
    /// play before committing to a download, and to tell the user why playback will
    /// be expensive. It does NOT let the guest pin an implementation — see
    /// `open-accelerated`.
    ///
    /// ENUMERATE-ALL vs PROBE-ONE: this lists the WHOLE decoder table (the
    /// `navigator.mediaCapabilities` / diagnostics role); `probe(config)` below
    /// answers "can I play THIS config, and on which lane" (the WebCodecs
    /// `isConfigSupported` role). A guest committing to one stream wants `probe`; a
    /// UI showing "what this device supports" wants `list-decoders`.
    list-decoders: func() -> list<decoder-info>;

    /// Can this host decode `config`, and on which lane? (= WebCodecs
    /// `AudioDecoder/VideoDecoder.isConfigSupported`, the faithful per-config probe;
    /// `support` is explicit about hardware vs software so the guest chooses its
    /// fallback rather than having the host hide it.) Shared shape with the
    /// wasi:audio-codec sibling so A/V capability checks are uniform.
    probe: func(config: decoder-config) -> support;

    /// A frame the host has decoded and still holds (PLAYBACK lane).
    ///
    /// OPAQUE BY DESIGN — pixels never cross the boundary; that is exactly what keeps
    /// decode-to-surface zero-copy. The guest decides only *WHEN* a frame is shown;
    /// *WHERE* it appears is the surface's vocabulary (the connected `context`). This
    /// is the shape the hardware already exposes: Android
    /// `MediaCodec.releaseOutputBuffer(index, renderTimestampNs)`, Apple
    /// `AVSampleBufferDisplayLayer`, the VA-API / Media Foundation equivalents — it
    /// gives WebCodecs' control flow with `<video>`'s zero-copy, which neither W3C
    /// model provides alone. Dropping the resource without `present` or `discard` is
    /// equivalent to `discard` — the buffer is released either way, never leaked.
    resource decoded-frame {
        /// The presentation timestamp carried through from `timed-frame`, in DISPLAY
        /// order (the host reorders B-frames; a guest never has to).
        timestamp-us: func() -> s64;

        /// Schedule presentation at `at-ns` on the wasi:clocks monotonic timeline —
        /// the clock a player converts into from wasi:audio `playback.position()`,
        /// the only real media clock in the system. That conversion is what makes
        /// A/V sync possible: video is slaved to the audio master clock. `0` =
        /// present as soon as possible. Composited into the surface bound by
        /// `connect`.
        present: func(at-ns: u64);

        /// Release without showing it — arrived too late, or invalidated by a seek. A
        /// player that falls behind discards rather than accumulating latency.
        discard: func();
    }

    resource video-decoder {
        /// Opens a HW/SW decoder. `keys` binds a wasi:eme key-session (= EME
        /// setMediaKeys) for an encrypted stream; none = cleartext. Robust DRM stays
        /// secure-surface-only (decode-to-surface already keeps frames host-side).
        /// Default acceleration policy: hardware first, software fallback.
        open: static func(config: decoder-config,
                          keys: option<borrow<key-session>>)
              -> result<video-decoder, video-error>;

        /// `open` with an explicit hardware/software preference. ADDITIVE: `open` and
        /// `decoder-config` are unchanged, because adding a field to that record
        /// would break the ABI of every shipped consumer (the call path is in
        /// production). A guest that does not care keeps calling `open`.
        open-accelerated: static func(config: decoder-config,
                                      keys: option<borrow<key-session>>,
                                      accel: acceleration)
              -> result<video-decoder, video-error>;

        /// Claim the surface socket: decoded output composites into the connected
        /// surface's buffers (one producer per context). Host-fill producers claim
        /// but do not pump the context — timing is driven internally (call lane) or
        /// by `decoded-frame.present(at-ns)` (playback lane), not by the context's
        /// `get-current-buffer`/`present`. Connect BEFORE the first `submit` /
        /// `submit-timed`; frames submitted before a connect MAY be dropped.
        connect: func(ctx: borrow<context>) -> result<_, video-error>;

        // ── RTP / call lane (live-call-verified; unchanged from 0.0.1) ──────────

        /// Push one compressed frame (after SRTP-open + RTP depacketize).
        submit: func(frame: encoded-frame) -> result<_, video-error>;

        /// Content-orientation correction in degrees CW (the peer's CVO rotation) —
        /// applied at composition, no codec reconfigure. Live-updatable mid-call.
        set-rotation: func(degrees: u32);

        /// Where the host has ACTUALLY placed the picture inside the connected
        /// surface, in surface pixels, after aspect-preserving letterbox/pillarbox
        /// and rotation — `none` until the first frame composites. The guest asks the
        /// surface for its size and the decoder where the picture LANDED inside it
        /// (not the same once aspect correction applies), to draw subtitles/controls
        /// over the picture and in the black bars. Subtitles are rendered in the
        /// guest's own UI layer at display resolution, not baked into the frame — the
        /// pixels never cross the boundary — so the guest needs this rect to place
        /// them. Every mature player carries the equivalent (mpv `mp_osd_res`, Kodi's
        /// three rects). Stays on the decoder because the letterbox is the producer's
        /// decision (see the header); a fill producer would have no such rect.
        presented-rect: func() -> option<content-rect>;

        /// true once at least one keyframe has decoded (UI can drop the placeholder).
        ready: func() -> bool;

        /// Frames decoded so far (diagnostics).
        decoded-frames: func() -> u64;

        /// Which implementation this decoder actually got. Needed because
        /// `acceleration` is a preference: a guest that asked for hardware and
        /// silently received software would otherwise have no way to know, and "why
        /// is this dropping frames" becomes unanswerable from inside the app.
        implementation: func() -> decoder-info;

        // ── PLAYBACK lane (task 117) — additive; a guest uses one lane or the
        // other, never both on the same decoder. ─────────────────────────────────

        /// Push a frame carrying a real presentation timestamp. `queue-full` here is
        /// BACK-PRESSURE, not loss: retry the SAME frame once `next-decoded` has
        /// drained one (see `video-error.queue-full`).
        submit-timed: func(frame: timed-frame) -> result<_, video-error>;

        /// Take the next decoded frame in DISPLAY order, if one is ready
        /// (non-blocking; `none` = not yet). Pair with the embedder's frame cadence
        /// for pacing rather than spinning.
        next-decoded: func() -> option<decoded-frame>;

        /// End of stream: finish decoding everything queued so the tail of the file
        /// is emitted via `next-decoded` (a codec holds frames for reordering that
        /// are otherwise never released). A keyframe is required to resume afterwards.
        flush: func() -> result<_, video-error>;

        /// Seek: discard queued input, held reference frames, and any scheduled
        /// presentations, and return to the pre-keyframe state — far less disruptive
        /// than closing and reopening the decoder.
        reset: func() -> result<_, video-error>;
    }
}

world video-decoder-guest {
    import types;
    import decoder;
}
