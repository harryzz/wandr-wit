// wasi:video-codec — DRAFT (wandr). NOT WIRED.
//
// The video hardware CODEC — decoder + encoder + the shared VideoFrame in ONE package,
// exactly parallel to `wasi:audio-codec` (and to WebCodecs, which ships VideoDecoder +
// VideoEncoder + VideoFrame together). Consolidates the earlier split
// wasi:video-decoder / wasi:video-encoder / wasi:video-frame drafts: one `codec` enum,
// one HW/SW vocabulary, one frame currency — no cross-package duplication.
//
// The A/V parallel and its ONE asymmetry: audio's raw frame (WebCodecs AudioData)
// crosses the boundary cheaply as `list<f32>`; a raw VIDEO frame cannot, so `frame` is
// an OPAQUE host-held resource (= WebCodecs VideoFrame) — pixels stay host-side and the
// handle is forwarded zero-copy (camera -> encoder, decoder -> surface), with
// `read-rgba` the expensive pixels-needed opt-out. Everything else mirrors audio-codec:
// `probe(config) -> support` (= isConfigSupported), identical `acceleration`, and the
// same "use HW if present, fall back in-process when absent" capability negotiation.
//
// ONE decode path (`submit(chunk)`), TWO presentation modes — chosen by whether the
// guest PULLS output, not by a second submit verb or a second chunk type:
//   * AUTO / real-time — submit and DON'T pull; the host presents each decoded frame
//                        ASAP to the connected surface (RTP calls; no per-frame guest
//                        work). The guest treats `queue-full` as LOSS (resend after a
//                        keyframe).
//   * GUEST-TIMED      — submit, then `next-decoded` -> `decoded-frame` -> `present(at-ns)`
//                        on the wasi:clocks monotonic timeline (video slaved to the
//                        wasi:audio master clock, A/V sync — file playback). `queue-full`
//                        = BACK-PRESSURE (retry the same chunk).
// One `encoded-chunk` (µs PTS) feeds both; an RTP guest converts its 90 kHz clock to µs.
// Live-verified: Signal calls; jellyfin + dash playback.
//
// Factored OUT (surface's job): placement AND sizing — `set-rect`/`set-visible`/
// z-layer, and the aspect-fit/letterbox — live in wasi:surface (request/configure).
// The GUEST sizes the video surface to the content aspect (it knows the surface size
// and, from demux, the display aspect), so there is NO host letterbox to report and no
// `presented-rect`: the guest that owns the fit already knows where the picture is, and
// draws subtitles/controls against its own layout. Content ORIENTATION stays here
// (`set-rotation`, `frame.rotation` — a property of the FRAMES). The camera SOURCE is
// wasi:camera (W3C Media Capture vs WebCodecs); it PRODUCES `frame`, this encoder
// CONSUMES it.
//
// Deps (wit/deps/): wasi:graphics-context (the decode-to-surface socket) + wasi:eme
// (decrypt-config on the frame + the key-session bound at decoder open).
package wasi:video-codec@0.0.1;

interface types {
    /// Codecs a host MAY accelerate. `av1` is DECODE-ONLY (playback): the host decodes
    /// it (dav1d / a HW block) but never encodes it — the encoder rejects av1 at
    /// `probe`/`open` (`no-hw-codec`), a runtime fact like VP9 HW-encode being absent.
    /// Discriminants stable: vp8=0…av1=4.
    enum codec { vp8, vp9, h264, h265, av1 }

    /// WebCodecs `hardwareAcceleration` preference. IDENTICAL to wasi:audio-codec's
    /// `acceleration` so a guest's HW/SW fallback is uniform across the A/V pair.
    /// `prefer-*` are hints (the host falls back); `require-hardware` is the honest
    /// fail-rather-than-pay-CPU opt-out (software VIDEO decode costs real CPU at frame
    /// rate) and the ONLY value that turns a working decode into an error.
    enum acceleration { no-preference, prefer-hardware, prefer-software, require-hardware }

    /// `probe` result (= WebCodecs isConfigSupported, explicit about the LANE so the
    /// guest chooses its fallback rather than having the host hide it). Shared shape
    /// with wasi:audio-codec's `support`.
    enum support { hardware, software, unsupported }

    /// Shared error vocabulary (parallel to wasi:audio-codec's `codec-error`).
    enum codec-error {
        unsupported-codec,
        no-hw-codec,          // only a software codec exists (or av1-on-encode)
        codec-init-failed,
        bad-frame,
        /// RTP lane: input queue full — frame dropped, resend after a keyframe.
        /// PLAYBACK lane (`submit-timed`): BACK-PRESSURE — retry the SAME frame once
        /// `next-decoded` drains one (a file cannot resync on a keyframe without a
        /// visible skip, so this inverts the RTP "drop it" meaning).
        queue-full,
        /// No connected surface can accept decode-to-surface output.
        surface-unavailable,
    }



    /// ENCRYPTED MEDIA (task 108): `decrypt` carries per-frame Common-Encryption params
    /// (= WebCodecs decryptConfig, owned by wasi:eme); the key comes from a wasi:eme
    /// key-session bound at decoder open. Additive; cleartext when `decrypt` = none.
    use wasi:eme/eme@0.0.1.{decrypt-config};

    /// One compressed frame (= WebCodecs `EncodedVideoChunk`; the audio sibling's
    /// `encoded-chunk`). ONE record for BOTH lanes — RTP/call and file/playback differ
    /// only in how the guest reads output back and reacts to `queue-full`, not in the
    /// input shape.
    ///
    /// `timestamp-us` is a real µs PRESENTATION timestamp (WebCodecs unit, matching
    /// wasi:audio-codec's s64), signed (containers carry negative PTS from edit lists /
    /// encoder delay). An RTP/call guest converts its 90 kHz transport timestamp to µs
    /// (× 100/9) before submitting — it already owns the RTP layer. Decode order in; the
    /// host emits DISPLAY order (it reorders B-frames).
    ///
    /// `decrypt`: none = cleartext (RTP calls are SRTP-opened at the transport, so it is
    /// none there); some = encrypted file, decrypted host-side via the bound key-session.
    record encoded-chunk {
        /// The compressed bytes of exactly one frame (Annex-B NAL units for H.264/265,
        /// a VP8/VP9 frame) — reassembled by the guest from RTP, or read from a demuxed
        /// container.
        data: list<u8>,
        /// Presentation timestamp, microseconds (see the record doc above).
        timestamp-us: s64,
        /// KEYFRAME (= WebCodecs `EncodedVideoChunk.type` "key" vs "delta"):
        /// true  = INTRA-coded — a complete, self-decodable picture (an H.264/H.265
        ///         IDR, a VP8/VP9 key frame). The only valid place to START or RESUME
        ///         decoding: a decoder must open on one, a seek jumps to the nearest
        ///         one, and `flush`/`reset` require one to resume.
        /// false = a DELTA / inter-coded frame (P/B): encoded as a difference from
        ///         earlier (or, with B-frames, later) frames, meaningless until its
        ///         reference frames have decoded.
        /// Carried explicitly, not inferred from the bitstream, so the host and guest
        /// act on it WITHOUT parsing the codec: the decoder rejects a stream that opens
        /// on a delta; an RTP receiver that lost packets requests a keyframe (RTCP
        /// PLI/FIR) and drops deltas until one arrives.
        keyframe: bool,
        /// Per-frame Common-Encryption params for encrypted media (see the record doc);
        /// none = cleartext.
        decrypt: option<decrypt-config>,
    }

    /// WebCodecs `VideoDecoderConfig` (subset). No `width`/`height`: they were a hint
    /// the codec overrides ("the stream's actual size wins" — VP8/VP9 keyframes and the
    /// in-band H.26x SPS carry dimensions), and the guest already has the size from
    /// demux, so a decoder never needs them at init.
    record decoder-config {
        codec: codec,
        /// HW/SW preference (= WebCodecs `hardwareAcceleration`). IN the config — not a
        /// separate `open-accelerated` verb — same shape as wasi:audio-codec's
        /// `decoder-config`. A guest that doesn't care sets `no-preference` and gets the
        /// host default (hardware first, software fallback).
        acceleration: acceleration,
    }

    /// WebCodecs `VideoEncoderConfig` (subset): the OUTPUT coded size + rate. Input
    /// frames are scaled to it as needed. No source/`facing` — that is wasi:camera's.
    record encoder-config {
        codec: codec,
        width: u32,
        height: u32,
        bitrate-bps: u32,
        framerate: u32,
        /// HW/SW preference (= WebCodecs `hardwareAcceleration`) — same as
        /// `decoder-config` and wasi:audio-codec's `encoder-config`. `no-preference` =
        /// host default (hardware first — a call encoder wants HW for battery; software
        /// fallback where a HW encoder is absent, e.g. VP9 encode on many SoCs).
        acceleration: acceleration,
    }

    /// The shared raw video frame — OPAQUE, host-held (= WebCodecs VideoFrame). The
    /// currency between a SOURCE (wasi:camera; later canvas / screen-share) and this
    /// encoder, plus the pixels-to-guest escape hatch. Pixels stay host-side; a handle
    /// is forwarded zero-copy. (The audio sibling's AudioData is `list<f32>` instead —
    /// audio pixels are cheap to cross; video's are not, hence the resource.)
    resource frame {
        /// Presentation timestamp, microseconds (the s64 WebCodecs unit — one media
        /// clock across camera / this codec / audio-codec).
        timestamp-us: func() -> s64;
        width: func() -> u32;
        height: func() -> u32;
        /// Content orientation: degrees CW for upright display — a source's CVO (e.g.
        /// the facing-adjusted camera sensor). A sink applies or forwards it.
        rotation: func() -> u32;
        /// Copy into guest memory as tightly-packed RGBA8 (width*height*4). EXPENSIVE
        /// (host converts + copies); `none` if the host cannot convert. The zero-copy
        /// paths never call it.
        read-rgba: func() -> option<list<u8>>;
        // Dropping the resource releases the host-held pixels (== WebCodecs
        // VideoFrame.close()); a forwarded frame is consumed by encode/present.
    }
}

interface decoder {
    use types.{codec, decoder-config, encoded-chunk, support, codec-error};
    use wasi:graphics-context/graphics-context@0.0.2.{context};
    use wasi:eme/eme@0.0.1.{key-session};

    /// = WebCodecs VideoDecoder.isConfigSupported — the faithful per-config probe, and
    /// the ONLY capability call a real guest needs. (Enumerating the whole decoder table
    /// and querying which impl an open decoder got are diagnostics/testing — see
    /// wandr:video-diag, deliberately out of this standard.)
    probe: func(config: decoder-config) -> support;

    /// A decoded frame the host holds — OPAQUE, pixels never cross; the guest decides
    /// only WHEN it shows. Pulled via `next-decoded` when a guest takes timing control.
    /// (Distinct from `frame`: this carries DISPLAY scheduling. Drop == discard, never
    /// leaked.)
    resource decoded-frame {
        /// PTS carried from the `encoded-chunk`, in DISPLAY order.
        timestamp-us: func() -> s64;
        /// Schedule presentation at `at-ns` on the wasi:clocks monotonic timeline
        /// (converted from wasi:audio `playback.position()` — video slaved to the
        /// audio master clock). `0` = ASAP. Composites into the surface from `connect`.
        present: func(at-ns: u64);
        /// Release without showing (too late, or a seek invalidated it).
        discard: func();
    }

    resource video-decoder {
        /// Open a HW/SW decoder. `config.acceleration` sets the HW/SW preference (=
        /// WebCodecs hardwareAcceleration); `keys` binds a wasi:eme key-session for an
        /// encrypted stream (none = cleartext).
        open: static func(config: decoder-config,
                          keys: option<borrow<key-session>>)
              -> result<video-decoder, codec-error>;

        /// Claim the surface socket: decoded output composites into the connected
        /// surface's buffers. Host-fill = claim-not-pump (timing is internal / via
        /// `decoded-frame.present`, not the context's get-current-buffer/present).
        /// Connect BEFORE the first submit; earlier frames MAY be dropped.
        connect: func(ctx: borrow<context>) -> result<_, codec-error>;

        /// Push one compressed frame (= WebCodecs VideoDecoder.decode(chunk)). Decode
        /// order in; the host reorders B-frames and emits DISPLAY order. `queue-full`
        /// means the input queue is full — the RESPONSE is the guest's policy: a
        /// real-time RTP guest DROPS it and resends after a keyframe (loss-tolerant); a
        /// file player treats it as BACK-PRESSURE and retries the SAME chunk once
        /// `next-decoded` has drained one (a file cannot skip to a keyframe cleanly).
        submit: func(chunk: encoded-chunk) -> result<_, codec-error>;

        /// Take the next decoded frame in DISPLAY order, if ready (non-blocking; `none`
        /// = not yet). OPTIONAL — this is how a guest takes TIMING CONTROL: pull the
        /// frame and `present(at-ns)` it (A/V sync against the wasi:audio master clock;
        /// file playback). If a guest NEVER pulls, the host presents each decoded frame
        /// ASAP to the connected surface (real-time calls — no per-frame guest work).
        /// One mode or the other, not a mix.
        ///
        /// POLL, not pollable: this returns `option` for the frame-paced reactor model
        /// (the embedder's on-frame tick is the wakeup; the host's `present(at-ns)` does
        /// the precise timing, so a guest never spins). A `wasi:io/poll` pollable for a
        /// self-scheduling PULL-profile guest is a deliberate additive deferral — the
        /// same push/pull split wasi:surface draws — added if such a consumer ships.
        next-decoded: func() -> option<decoded-frame>;

        /// Content-orientation correction, degrees CW (the peer's CVO) — at composition,
        /// no codec reconfigure; live-updatable mid-call.
        set-rotation: func(degrees: u32);
        /// true once >=1 keyframe has decoded and composited — the signal to drop a
        /// "connecting…" placeholder. Genuinely host-only in the AUTO-present/call path
        /// (the guest never pulls `next-decoded` there, so it cannot otherwise know when
        /// video first appears). NOTE: probably UNNECESSARY — redundant in the
        /// guest-timed path (where `next-decoded` returning a frame is the same signal),
        /// and a guest content to show a black surface until frames arrive needs it not.
        /// Kept only for the placeholder-UX signal; a candidate to drop. Diagnostics
        /// (`decoded-frames`, `implementation`, `list-decoders`) live in wandr:video-diag.
        ready: func() -> bool;
        /// End of stream: flush the reorder buffer out via `next-decoded` (a keyframe
        /// is required to resume).
        flush: func() -> result<_, codec-error>;
        /// Seek: discard queued input, reference frames, and scheduled presentations;
        /// back to pre-keyframe state — far cheaper than close+reopen.
        reset: func() -> result<_, codec-error>;
    }
}

interface encoder {
    use types.{codec, encoder-config, encoded-chunk, support, codec-error, frame};

    /// = WebCodecs VideoEncoder.isConfigSupported. (av1 -> `unsupported`: decode-only.)
    probe: func(config: encoder-config) -> support;

    resource video-encoder {
        /// Open a hardware encoder for `config`. No camera, no surface — pure codec.
        open: static func(config: encoder-config)
              -> result<video-encoder, codec-error>;

        /// Submit one raw frame (= WebCodecs VideoEncoder.encode(VideoFrame)). The
        /// frame is BORROWED — the source (wasi:camera / canvas) keeps ownership;
        /// pixels stay host-side, so a camera frame encodes zero-copy. `frame.rotation`
        /// travels with the frame; the encoder does not interpret it.
        encode: func(frame: borrow<frame>) -> result<_, codec-error>;

        /// Pull the next compressed chunk (= the EncodedVideoChunk output); none = not
        /// ready yet. The guest RTP-packetizes + SRTP-seals + sends.
        next-chunk: func() -> option<encoded-chunk>;

        /// Force a keyframe (on the receiver's RTCP PLI/FIR).
        request-keyframe: func();
        /// Adapt to congestion (the guest drives this from REMB/TWCC).
        set-bitrate: func(bitrate-bps: u32);
    }
}

world video-codec-guest {
    import types;
    import decoder;
    import encoder;
}
