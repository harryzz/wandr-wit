// UPSTREAM-OWNED PACKAGE (wasi-gfx org) — this is wandr's PROPOSED
// CHANGE-SET as a validatable sketch (capability-granted context via
// surface.get-context, request/configure geometry, configure-with-scale,
// optional pull-profile events, advisory ui-relationship), NOT a wandr
// package and claiming no version lineage (DESIGN.md §ownership).
// Ship-before-upstream fallback = wandr:surface@0.0.1.
// Validation: `wasm-tools component wit .`
package wasi:surface@0.0.2;

interface surface {
    use wasi:graphics-context/graphics-context@0.0.2.{context};

    /// A media/child surface's advisory stacking relationship to the
    /// embedder's OWN UI layer — the factored home of wandr:video's
    /// guest-owned `z-layer`. `behind-ui` = the embedder's UI may draw OVER
    /// this surface (transparent-hole / SurfaceView model — e.g. video with
    /// controls on top); `above-ui` = this surface covers its rect and the UI
    /// lays out around it. It is a CONTENT intent about this surface's relation
    /// to its own UI, NOT global stacking (which stays composition authority).
    enum ui-relationship { behind-ui, above-ui }

    /// Authoritative geometry (xdg_shell model: clients REQUEST,
    /// compositors CONFIGURE). Delivered via the embedder's event
    /// profile: push = frame-handler.on-resize (+ metrics re-query),
    /// pull = the optional surface-events pollables.
    record configure-event {
        width:  u32,
        height: u32,
        /// Device scale (1.0 = 1:1). Phones: fixed; desktops: changes
        /// when a window crosses monitors.
        scale:  f32,
    }

    resource surface {
        /// No constructor: surfaces are EMBEDDER-GRANTED (a reactor
        /// guest's primary surface via its world entry; child surfaces
        /// via embedder policy — wandr: the arbiter).
        width:  func() -> u32;
        height: func() -> u32;
        scale:  func() -> f32;
        /// Advisory; the embedder MAY ignore it. Authoritative size
        /// always arrives as a configure.
        request-set-size: func(width: option<u32>, height: option<u32>);
        /// Advisory content-relationship of THIS surface to the embedder's own
        /// UI layer (see `ui-relationship`). Advisory — the embedder MAY ignore
        /// it (global stacking is composition authority, never a guest call);
        /// the guest only expresses intent. This is where wandr:video's
        /// guest-owned `z-layer` factors to: the guest REQUESTS, the embedder
        /// CONFIGURES. Same request/configure discipline as `request-set-size`.
        request-ui-relationship: func(rel: ui-relationship);
        /// The surface's swapchain socket — one per surface, stable.
        get-context: func() -> context;
    }
}

/// OPTIONAL pull-profile events, for guests that own a poll loop.
/// Reactor-class guests use wasi:input-handlers instead (push profile);
/// the two never coexist on one surface (embedder routes exclusively).
interface surface-events {
    use wasi:io/poll@0.2.0.{pollable};
    use surface.{surface, configure-event};

    subscribe-configure: func(s: borrow<surface>) -> pollable;
    get-configure:       func(s: borrow<surface>) -> option<configure-event>;
}

world surface-guest {
    import surface;
}
